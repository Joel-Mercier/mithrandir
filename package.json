{
  "name": "mithrandir",
  "private": true,
  "type": "module",
  "workspaces": ["cli", "docs"],
  "scripts": {
    "cli:start": "bun run --filter @mithrandir/cli start",
    "cli:build": "bun run --filter @mithrandir/cli build",
    "cli:typecheck": "bun run --filter @mithrandir/cli typecheck",
    "cli:test": "bun run --filter @mithrandir/cli test",
    "docs:dev": "bun run --filter @mithrandir/docs dev",
    "docs:build": "bun run --filter @mithrandir/docs build",
    "docs:preview": "bun run --filter @mithrandir/docs preview",
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "release": "bash scripts/release.sh"
  }
}
