# Docker Setup Configuration
# Customize these values as needed

# User and Group IDs for Docker containers
PUID=1000
PGID=1000

# Timezone
TZ=Etc/UTC

# Base directory for all Docker app folders
# Leave empty to be prompted during setup
BASE_DIR=

# Local IP address (auto-detected if not set)
LOCAL_IP=

# DuckDNS Configuration
DUCKDNS_SUBDOMAINS=
DUCKDNS_TOKEN=

# WireGuard Configuration
WG_SERVERURL=
WG_PEERS=1

# Navidrome Spotify Configuration
ND_SPOTIFY_ID=
ND_SPOTIFY_SECRET=

# Pi-hole Configuration
PIHOLE_PASSWORD=

# Immich Configuration
IMMICH_DB_PASSWORD=postgres

# Sure Configuration
# SECRET_KEY_BASE is auto-generated with `openssl rand -hex 64` during install
SURE_SECRET_KEY_BASE=
SURE_DB_PASSWORD=sure_password
# Optional: OpenAI integration for AI-powered features
SURE_OPENAI_ACCESS_TOKEN=
SURE_OPENAI_URI_BASE=
SURE_OPENAI_MODEL=

# AFFiNE Configuration
AFFINE_DB_PASSWORD=affine
AFFINE_DB_USERNAME=affine

# Penpot Configuration
PENPOT_SECRET_KEY=
PENPOT_DB_PASSWORD=penpot
PENPOT_PUBLIC_URI=http://localhost:9001

# AdventureLog Configuration
# SECRET_KEY is auto-generated with `openssl rand -hex 32` during install
ADVENTURELOG_SECRET_KEY=
ADVENTURELOG_DB_PASSWORD=adventurelog
ADVENTURELOG_ADMIN_USERNAME=admin
ADVENTURELOG_ADMIN_PASSWORD=admin
ADVENTURELOG_ADMIN_EMAIL=admin@example.com

# Your Spotify Configuration
# Requires a Spotify Developer Application: https://developer.spotify.com/dashboard
# Create an app, set the redirect URI to {API_ENDPOINT}/oauth/spotify/callback
YOURSPOTIFY_CLIENT_ID=
YOURSPOTIFY_CLIENT_SECRET=

# Gatus Monitoring
# Discord webhook URL for Gatus alerts (leave empty to be prompted during setup)
GATUS_DISCORD_WEBHOOK_URL=

# Auto-yes mode (skip prompts)
# Set to 'true' to automatically accept all prompts
AUTO_YES=false

# Backup Configuration
BACKUP_DIR=/backups
LOCAL_RETENTION=5
REMOTE_RETENTION=10
RCLONE_REMOTE=gdrive
APPS=auto
# Backup encryption password (optional)
# When set, all backups are encrypted with AES-256-CBC before storage
# IMPORTANT: Store this password somewhere safe — without it, encrypted backups cannot be restored
BACKUP_PASSWORD=

# HTTPS Configuration (Caddy reverse proxy)
# Run 'mithrandir install https' to enable — requires DuckDNS
ENABLE_HTTPS=false
ACME_EMAIL=

# Firewall Configuration (UFW + ufw-docker)
# Run 'mithrandir install firewall' to enable
ENABLE_FIREWALL=false

# Google Drive rclone auto-configuration
# Set all 3 values to auto-generate rclone.conf (no manual 'rclone config' needed)
# Get your own client ID: https://rclone.org/drive/#making-your-own-client-id
RCLONE_GDRIVE_APP_ID=
RCLONE_GDRIVE_APP_SECRET=
RCLONE_GDRIVE_TOKEN=
