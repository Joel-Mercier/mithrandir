exports[`generateCompose app with secrets (DuckDNS) 1`] = `
"services:
  duckdns:
    image: lscr.io/linuxserver/duckdns:latest
    container_name: duckdns
    network_mode: host
    environment:
      - PUID=1000
      - PGID=1000
      - TZ=Etc/UTC
      - UPDATE_IP=ipv4
      - LOG_FILE=false
      - SUBDOMAINS=mylab
      - TOKEN=abc-123-token
    volumes:
      - /home/test/duckdns/config:/config
    restart: unless-stopped
"
`;

exports[`generateCompose app with healthcheck (Seerr) 1`] = `
"services:
  seerr:
    image: ghcr.io/seerr-team/seerr:latest
    container_name: seerr
    init: true
    environment:
      - TZ=Etc/UTC
      - LOG_LEVEL=info
      - PORT=5055
    ports:
      - 5055:5055
    volumes:
      - /home/test/seerr/app/config:/app/config
    healthcheck:
      test: ["CMD-SHELL", "wget --no-verbose --tries=1 --spider http://localhost:5055/api/v1/status || exit 1"]
      start_period: 20s
      timeout: 3s
      interval: 15s
      retries: 3
    restart: unless-stopped
"
`;

exports[`generateCompose app with capabilities/sysctls (WireGuard) 1`] = `
"services:
  wireguard:
    image: lscr.io/linuxserver/wireguard:latest
    container_name: wireguard
    cap_add:
      - NET_ADMIN
      - SYS_MODULE
    sysctls:
      - net.ipv4.conf.all.src_valid_mark=1
    environment:
      - PUID=1000
      - PGID=1000
      - TZ=Etc/UTC
      - SERVERPORT=51820
      - PEERDNS=auto
      - INTERNAL_SUBNET=10.13.13.0
      - LOG_CONFS=true
      - SERVERURL=vpn.example.com
      - PEERS=3
    ports:
      - 51820:51820/udp
    volumes:
      - /home/test/wireguard/config:/config
      - /home/test/wireguard/lib/modules:/lib/modules:ro
    restart: unless-stopped
"
`;

exports[`generateCompose app with multiple config dirs (Homarr) 1`] = `
"services:
  homarr:
    image: ghcr.io/ajnart/homarr:latest
    container_name: homarr
    environment:
      - TZ=Etc/UTC
    ports:
      - 7575:7575
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - /home/test/homarr/configs:/app/data/configs
      - /home/test/homarr/icons:/app/public/icons
      - /home/test/homarr/data:/data
    restart: unless-stopped
"
`;

