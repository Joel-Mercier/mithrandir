exports[`generateCompose Pi-hole with ENABLE_HTTPS=false 1`] = `
"services:
  pihole:
    image: pihole/pihole:latest
    container_name: pihole
    cap_add:
      - NET_ADMIN
      - SYS_TIME
      - SYS_NICE
    environment:
      - TZ=Etc/UTC
      - FTLCONF_dns_listeningMode=ALL
      - FTLCONF_misc_etc_dnsmasq_d=true
      - FTLCONF_webserver_api_password=admin123
    ports:
      - 80:80
      - 53:53/tcp
      - 53:53/udp
      - 443:443/tcp
    volumes:
      - /home/test/pihole/etc-pihole:/etc/pihole
      - /home/test/pihole/etc-dnsmasq.d:/etc/dnsmasq.d
    restart: unless-stopped
"
`;

exports[`generateCompose Pi-hole with ENABLE_HTTPS=true (port remapping) 1`] = `
"services:
  pihole:
    image: pihole/pihole:latest
    container_name: pihole
    cap_add:
      - NET_ADMIN
      - SYS_TIME
      - SYS_NICE
    environment:
      - TZ=Etc/UTC
      - FTLCONF_dns_listeningMode=ALL
      - FTLCONF_misc_etc_dnsmasq_d=true
      - FTLCONF_webserver_api_password=admin123
      - FTLCONF_webserver_domain=pihole.mylab.duckdns.org
    ports:
      - 8880:80
      - 53:53/tcp
      - 53:53/udp
    volumes:
      - /home/test/pihole/etc-pihole:/etc/pihole
      - /home/test/pihole/etc-dnsmasq.d:/etc/dnsmasq.d
    restart: unless-stopped
"
`;

exports[`generateCompose rawCompose app (Immich) returns non-empty string 1`] = `
"services:
  immich-server:
    image: ghcr.io/immich-app/immich-server:release
    container_name: immich_server
    environment:
      - DB_PASSWORD=testpass
      - DB_USERNAME=postgres
      - DB_DATABASE_NAME=immich
      - DB_HOSTNAME=immich-postgres
      - REDIS_HOSTNAME=immich-redis
      - TZ=Etc/UTC
    ports:
      - 2283:2283
    volumes:
      - /home/test/data/media/pictures:/data
      - /etc/localtime:/etc/localtime:ro
    depends_on:
      - immich-redis
      - immich-postgres
    restart: unless-stopped
    healthcheck:
      disable: false

  immich-machine-learning:
    image: ghcr.io/immich-app/immich-machine-learning:release
    container_name: immich_machine_learning
    volumes:
      - immich-model-cache:/cache
    environment:
      - DB_PASSWORD=testpass
      - DB_USERNAME=postgres
      - DB_DATABASE_NAME=immich
      - DB_HOSTNAME=immich-postgres
      - REDIS_HOSTNAME=immich-redis
    restart: unless-stopped
    healthcheck:
      disable: false

  immich-redis:
    image: docker.io/valkey/valkey:9
    container_name: immich_redis
    healthcheck:
      test: redis-cli ping || exit 1
    restart: unless-stopped

  immich-postgres:
    image: ghcr.io/immich-app/postgres:14-vectorchord0.4.3-pgvectors0.2.0
    container_name: immich_postgres
    environment:
      - POSTGRES_PASSWORD=testpass
      - POSTGRES_USER=postgres
      - POSTGRES_DB=immich
      - POSTGRES_INITDB_ARGS=--data-checksums
    volumes:
      - /home/test/immich/postgres:/var/lib/postgresql/data
    shm_size: 128mb
    restart: unless-stopped
    healthcheck:
      disable: false

volumes:
  immich-model-cache:
"
`;

