// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`generateCompose simple LinuxServer app (Sonarr) 1`] = `
"services:
  sonarr:
    image: lscr.io/linuxserver/sonarr:latest
    container_name: sonarr
    environment:
      - PUID=1000
      - PGID=1000
      - TZ=Etc/UTC
    ports:
      - 8989:8989
    volumes:
      - /home/test/sonarr/config:/config
      - /home/test/data:/data
    restart: unless-stopped
"
`;

