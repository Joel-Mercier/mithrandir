{
  "name": "@mithrandir/cli",
  "version": "1.0.0",
  "type": "module",
  "description": "Automated Docker-based homelab setup, backup, and restore CLI",
  "bin": {
    "mithrandir": "./dist/mithrandir.js"
  },
  "exports": {
    ".": "./dist/mithrandir.js",
    "./lib/*": "./src/lib/*.ts"
  },
  "scripts": {
    "start": "bun run src/index.tsx",
    "build": "bun run build.ts",
    "typecheck": "bunx tsc --noEmit -p tsconfig.json",
    "test": "bun test"
  },
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "ink": "^7.0.1",
    "ink-link": "^5.0.0",
    "ink-spinner": "^5.0.0",
    "meow": "^14.1.0",
    "react": "^19.2.5"
  },
  "devDependencies": {
    "@types/bun": "1.3.12",
    "@types/react": "^19.2.14",
    "typescript": "^6.0.3"
  }
}
