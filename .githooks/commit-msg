#!/usr/bin/env bash
# commit-msg hook: regenerate changelog including the pending commit message

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

# Read the first line of the commit message (subject)
PENDING_MSG="$(head -1 "$1")"
export PENDING_MSG

"$REPO_ROOT/scripts/generate-changelog.sh"
git add "$REPO_ROOT/docs/changelog.md"
